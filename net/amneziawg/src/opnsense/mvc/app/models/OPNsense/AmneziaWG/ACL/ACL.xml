<acl>
   <page-amneziawg-config>
      <name>VPN: AmneziaWG: Configuration</name>
      <patterns>
         <pattern>ui/amneziawg/*</pattern>
         <pattern>api/amneziawg/server/*</pattern>
         <pattern>api/amneziawg/client/*</pattern>
         <pattern>api/amneziawg/general/*</pattern>
         <pattern>api/amneziawg/service/*</pattern>
      </patterns>
   </page-amneziawg-config>
   <page-amneziawg-diagnostics>
      <name>VPN: AmneziaWG: Status</name>
      <patterns>
         <pattern>ui/amneziawg/diagnostics/*</pattern>
         <pattern>api/amneziawg/service/*</pattern>
      </patterns>
   </page-amneziawg-diagnostics>
   <page-amneziawg-logs>
      <name>VPN: AmneziaWG: Log</name>
      <patterns>
         <pattern>ui/diagnostics/log/core/amneziawg/*</pattern>
         <pattern>api/diagnostics/log/core/amneziawg/*</pattern>
      </patterns>
   </page-amneziawg-logs>
</acl>
