<model>
    <mount>//OPNsense/amneziawg/server</mount>
    <description>AmneziaWG instance configuration</description>
    <version>1.0.1</version>
    <items>
        <servers>
            <server type=".\ServerField">
                <enabled type="BooleanField">
                    <Default>1</Default>
                    <Required>Y</Required>
                </enabled>
                <name type="TextField">
                    <Required>Y</Required>
                    <Mask>/^([0-9a-zA-Z._\-]){1,64}$/u</Mask>
                    <ValidationMessage>Should be a string between 1 and 64 characters. Allowed characters are alphanumeric characters, dash and underscores.</ValidationMessage>
                </name>
                <instance type="AutoNumberField">
                    <Required>Y</Required>
                    <MinimumValue>0</MinimumValue>
                </instance>
                <pubkey type="Base64Field"/>
                <privkey type="Base64Field">
                    <Required>Y</Required>
                    <ValidationMessage>A private key is required.</ValidationMessage>
                </privkey>
                <port type="PortField"/>
                <mtu type="IntegerField">
                    <MinimumValue>1</MinimumValue>
                    <MaximumValue>9300</MaximumValue>
                </mtu>
                <dns type="NetworkField">
                    <AsList>Y</AsList>
                    <NetMaskAllowed>N</NetMaskAllowed>
                    <WildcardEnabled>N</WildcardEnabled>
                    <ValidationMessage>Please use valid IPv4 or IPv6 addresses.</ValidationMessage>
                </dns>
                <tunneladdress type="NetworkField">
                    <NetMaskRequired>Y</NetMaskRequired>
                    <AsList>Y</AsList>
                </tunneladdress>
                <disableroutes type="BooleanField">
                    <Default>0</Default>
                    <Required>Y</Required>
                    <Constraints>
                        <check001>
                            <ValidationMessage>You have to enable Disable Routes option.</ValidationMessage>
                            <type>DependConstraint</type>
                            <addFields>
                                <field1>gateway</field1>
                            </addFields>
                        </check001>
                    </Constraints>
                </disableroutes>
                <gateway type="NetworkField"/>
                <carp_depend_on type="VirtualIPField">
                    <type>carp</type>
                    <key>mvc</key>
                </carp_depend_on>
                <peers type="ModelRelationField">
                    <Model>
                        <template>
                            <source>OPNsense.AmneziaWG.Client</source>
                            <items>clients.client</items>
                            <display>name</display>
                        </template>
                    </Model>
                    <Multiple>Y</Multiple>
                    <ValidationMessage>Choose a peer.</ValidationMessage>
                </peers>
                <debug type="BooleanField">
                    <Default>0</Default>
                    <Required>Y</Required>
                </debug>
                <!-- AmneziaWG 2.0 [Interface], all empty = plain WireGuard -->
                <!-- profile chosen for the generator button of the dialog, only remembered, awg does not use it -->
                <awg2_profile type="OptionField">
                    <Required>Y</Required>
                    <Default>none</Default>
                    <OptionValues>
                        <none value="none">Select UDP protocol to mimic</none>
                        <random value="random">Random</random>
                        <http3 value="http3">HTTP/3 (443)</http3>
                        <dns value="dns">DNS (53)</dns>
                        <ntp value="ntp">NTP (123)</ntp>
                        <stun value="stun">STUN (3478)</stun>
                        <sip value="sip">SIP (5060)</sip>
                    </OptionValues>
                </awg2_profile>
                <!-- where the server name of the HTTP/3 signature packets comes from: list, an interface, an address or a host name -->
                <sni_source type="TextField">
                    <Default>wan</Default>
                    <Mask>/^(list|[A-Za-z0-9]([A-Za-z0-9._-]{0,251}[A-Za-z0-9])?|[0-9A-Fa-f:.]{2,45})$/</Mask>
                    <ValidationMessage>Enter an interface, an address, a host name or list.</ValidationMessage>
                </sni_source>
                <!-- the server name of the packets that were generated last, shown in the dialog, awg does not use it -->
                <sni_used type="TextField">
                    <Mask>/^[A-Za-z0-9]([A-Za-z0-9._-]{0,251}[A-Za-z0-9])?$/</Mask>
                    <ValidationMessage>Not a valid host name.</ValidationMessage>
                </sni_used>
                <!-- captured client Initial datagrams (hex, one per line) the gear builds the HTTP/3 signature packets from, awg does not use it -->
                <quic_template type="TextField">
                    <Mask>/^[0-9a-fA-Fx\s,;]*$/</Mask>
                    <ValidationMessage>Enter the datagrams as hex, one per line.</ValidationMessage>
                </quic_template>
                <jc type="IntegerField">
                    <MinimumValue>0</MinimumValue>
                    <MaximumValue>128</MaximumValue>
                </jc>
                <jmin type="IntegerField">
                    <MinimumValue>0</MinimumValue>
                    <MaximumValue>1280</MaximumValue>
                </jmin>
                <jmax type="IntegerField">
                    <MinimumValue>0</MinimumValue>
                    <MaximumValue>1280</MaximumValue>
                </jmax>
                <s1 type="IntegerField">
                    <MinimumValue>0</MinimumValue>
                    <MaximumValue>1304</MaximumValue>
                </s1>
                <s2 type="IntegerField">
                    <MinimumValue>0</MinimumValue>
                    <MaximumValue>1360</MaximumValue>
                </s2>
                <s3 type="IntegerField">
                    <MinimumValue>0</MinimumValue>
                    <MaximumValue>1388</MaximumValue>
                </s3>
                <s4 type="IntegerField">
                    <MinimumValue>0</MinimumValue>
                    <MaximumValue>160</MaximumValue>
                </s4>
                <h1 type="TextField">
                    <Mask>/^[0-9]{1,10}(-[0-9]{1,10})?$/</Mask>
                    <ValidationMessage>Enter a number or a range (e.g. 123456-123999).</ValidationMessage>
                </h1>
                <h2 type="TextField">
                    <Mask>/^[0-9]{1,10}(-[0-9]{1,10})?$/</Mask>
                    <ValidationMessage>Enter a number or a range (e.g. 123456-123999).</ValidationMessage>
                </h2>
                <h3 type="TextField">
                    <Mask>/^[0-9]{1,10}(-[0-9]{1,10})?$/</Mask>
                    <ValidationMessage>Enter a number or a range (e.g. 123456-123999).</ValidationMessage>
                </h3>
                <h4 type="TextField">
                    <Mask>/^[0-9]{1,10}(-[0-9]{1,10})?$/</Mask>
                    <ValidationMessage>Enter a number or a range (e.g. 123456-123999).</ValidationMessage>
                </h4>
                <i1 type="TextField">
                    <Mask>/^( *&lt;(b 0x([0-9a-fA-F]{2})+|r [0-9]+|rc [0-9]+|rd [0-9]+|t|c)&gt;)+ *$/</Mask>
                    <ValidationMessage>Use CPS tags written in angle brackets: b 0x.. (an even number of hex digits), r N, rc N, rd N, t or c.</ValidationMessage>
                </i1>
                <i2 type="TextField">
                    <Mask>/^( *&lt;(b 0x([0-9a-fA-F]{2})+|r [0-9]+|rc [0-9]+|rd [0-9]+|t|c)&gt;)+ *$/</Mask>
                    <ValidationMessage>Use CPS tags written in angle brackets: b 0x.. (an even number of hex digits), r N, rc N, rd N, t or c.</ValidationMessage>
                </i2>
                <i3 type="TextField">
                    <Mask>/^( *&lt;(b 0x([0-9a-fA-F]{2})+|r [0-9]+|rc [0-9]+|rd [0-9]+|t|c)&gt;)+ *$/</Mask>
                    <ValidationMessage>Use CPS tags written in angle brackets: b 0x.. (an even number of hex digits), r N, rc N, rd N, t or c.</ValidationMessage>
                </i3>
                <i4 type="TextField">
                    <Mask>/^( *&lt;(b 0x([0-9a-fA-F]{2})+|r [0-9]+|rc [0-9]+|rd [0-9]+|t|c)&gt;)+ *$/</Mask>
                    <ValidationMessage>Use CPS tags written in angle brackets: b 0x.. (an even number of hex digits), r N, rc N, rd N, t or c.</ValidationMessage>
                </i4>
                <i5 type="TextField">
                    <Mask>/^( *&lt;(b 0x([0-9a-fA-F]{2})+|r [0-9]+|rc [0-9]+|rd [0-9]+|t|c)&gt;)+ *$/</Mask>
                    <ValidationMessage>Use CPS tags written in angle brackets: b 0x.. (an even number of hex digits), r N, rc N, rd N, t or c.</ValidationMessage>
                </i5>
                <!-- AmneziaWG 3.x [Interface], all optional -->
                <!-- switch for the AmneziaWG 3.x options below: when off they are stored but not used -->
                <awg3_enabled type="BooleanField">
                    <Default>0</Default>
                    <Required>Y</Required>
                </awg3_enabled>
                <headerprotectionkey type="Base64Field"/>
                <contentpaddingaddition type="TextField">
                    <Mask>/^[0-9]{1,5}(-[0-9]{1,5})?$/</Mask>
                    <ValidationMessage>Enter a number or a range (e.g. 10-20).</ValidationMessage>
                </contentpaddingaddition>
                <rekeyaftertime type="TextField">
                    <Mask>/^[0-9]{1,5}(-[0-9]{1,5})?$/</Mask>
                    <ValidationMessage>Enter a number or a range (e.g. 10-20).</ValidationMessage>
                </rekeyaftertime>
                <rekeytimeout type="TextField">
                    <Mask>/^[0-9]{1,5}(-[0-9]{1,5})?$/</Mask>
                    <ValidationMessage>Enter a number or a range (e.g. 10-20).</ValidationMessage>
                </rekeytimeout>
                <rejectaftertime type="TextField">
                    <Mask>/^[0-9]{1,5}(-[0-9]{1,5})?$/</Mask>
                    <ValidationMessage>Enter a number or a range (e.g. 10-20).</ValidationMessage>
                </rejectaftertime>
                <keepalivetimeout type="TextField">
                    <Mask>/^[0-9]{1,5}(-[0-9]{1,5})?$/</Mask>
                    <ValidationMessage>Enter a number or a range (e.g. 10-20).</ValidationMessage>
                </keepalivetimeout>
                <maxhandshakeattempts type="TextField">
                    <Mask>/^[0-9]{1,5}(-[0-9]{1,5})?$/</Mask>
                    <ValidationMessage>Enter a number or a range (e.g. 10-20).</ValidationMessage>
                </maxhandshakeattempts>
                <randomtrailers type="BooleanField">
                    <Default>0</Default>
                    <Required>Y</Required>
                </randomtrailers>
                <disablecookies type="BooleanField">
                    <Default>0</Default>
                    <Required>Y</Required>
                </disablecookies>
                <cnfFilename type="TextField" volatile="true"/>
                <statFilename type="TextField" volatile="true"/>
                <interface type="TextField" volatile="true"/>
                <!-- Peer generator storage [default values] -->
                <endpoint type="TextField"/>
                <peer_dns type="TextField"/>
                <allowed_ips type="TextField"/>
            </server>
        </servers>
    </items>
</model>
